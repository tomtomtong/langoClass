{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "langoclass",
  "account_id": "ee3f12054fd4aff92582d187eb1fb320",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    // The Node server (classroom.lango.ai) is retired; nothing is proxied to it.
    "CMS_API_BASE": "https://newcms.lango.ai"
  },
  "containers": [
    {
      "class_name": "MediaContainer",
      "image": "./container/Dockerfile",
      "image_build_context": "./container",
      // worker/media-speech.js MEDIA_INSTANCES spreads requests over three.
      "max_instances": 3,
      "instance_type": "basic"
    },
    {
      // Uncle Tommy lecture videos (worker/video-container.js); one instance per job.
      "class_name": "VideoContainer",
      "image": "./video-container/Dockerfile",
      "image_build_context": "./video-container",
      // More jobs than this wait in line (worker/video-container.js tryStart).
      "max_instances": 5,
      "instance_type": "standard-4"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDurableObject" },
      { "name": "MEDIA", "class_name": "MediaContainer" },
      { "name": "VIDEO", "class_name": "VideoContainer" }
    ]
  },
  "exports": {
    "RoomDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "MediaContainer": { "type": "durable-object", "storage": "sqlite" },
    "VideoContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "langoclass-uploads"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "langoclass",
      "database_id": "d8db221b-036f-4b3d-8080-fac1e0e64386",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "routes": [
    {
      "pattern": "class.lango.ai",
      "custom_domain": true
    }
  ]
}
