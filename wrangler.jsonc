{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "langoclass",
  "account_id": "ee3f12054fd4aff92582d187eb1fb320",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    // The Node server (classroom.lango.ai) is retired; nothing is proxied to it.
    "CMS_API_BASE": "https://newcms.lango.ai",
    // Shared Lango log service (Lango 3.0). Remove LOG_INGEST_URL, or set LOG_ENABLED to "false", to stop sending.
    "LOG_INGEST_URL": "https://log.lango.ai/api/ingest",
    "LOG_ENVIRONMENT": "production",
    // Turnstile widget site key (public). Also set the secret: wrangler secret put TURNSTILE_SECRET_KEY
    "TURNSTILE_SITE_KEY": ""
  },
  "containers": [
    {
      "class_name": "MediaContainer",
      "image": "./container/Dockerfile",
      "image_build_context": "./container",
      // worker/media-speech.js MEDIA_INSTANCES spreads requests over three.
      "max_instances": 3,
      "instance_type": "basic"
    },
    {
      // Uncle Tommy lecture videos (worker/video-container.js); one instance per job.
      "class_name": "VideoContainer",
      "image": "./video-container/Dockerfile",
      "image_build_context": "./video-container",
      // More jobs than this wait in line (worker/video-container.js tryStart).
      "max_instances": 5,
      "instance_type": "standard-4"
    },
    {
      // Autoclass lesson renders (worker/autoclass-container.js): the same image, its own line.
      "class_name": "AutoclassContainer",
      "image": "./video-container/Dockerfile",
      "image_build_context": "./video-container",
      "max_instances": 2,
      "instance_type": "standard-4"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDurableObject" },
      { "name": "MEDIA", "class_name": "MediaContainer" },
      { "name": "VIDEO", "class_name": "VideoContainer" },
      { "name": "AUTOCLASS_VIDEO", "class_name": "AutoclassContainer" }
    ]
  },
  "exports": {
    "RoomDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "MediaContainer": { "type": "durable-object", "storage": "sqlite" },
    "VideoContainer": { "type": "durable-object", "storage": "sqlite" },
    "AutoclassContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  // Hourly: remove old autoclass render folders (worker/autoclass-cleanup.js).
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "langoclass-uploads"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "langoclass",
      "database_id": "d8db221b-036f-4b3d-8080-fac1e0e64386",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    // /autoclass*: the internal autoclass test page, off unless AUTOCLASS=1 (worker/autoclass-page.js).
    "run_worker_first": ["/api/*", "/uploads/*", "/autoclass*"]
  },
  "routes": [
    {
      "pattern": "class.lango.ai",
      "custom_domain": true
    }
  ]
}
