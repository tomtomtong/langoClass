# LangoClass HK elderly — copy to .env.hk-elderly (or export these) for Deploy B.
# Main LangoClass keeps using .env / no APP_VARIANT. Do not point both
# instances at the same PERSISTENT_DATA_PATH.

PORT=3001
APP_VARIANT=hk-elderly
PUBLIC_BASE_URL=https://hk.langoclass.ai
PERSISTENT_DATA_PATH=./hk-data
INWORLD_STT_LANGUAGE=yue

# INWORLD_API_KEY=
# OPENROUTER_API_KEY=
